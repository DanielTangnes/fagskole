 {{ ansible_managed }}

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket {{ haproxy_socket }} mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    server-state-file {{ haproxy_state_file }}

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    # If a request hits a server that just went away, retry it elsewhere
    option  redispatch
    retries 3
    load-server-state-from-file global
    timeout connect         5s
    timeout client          30s
    timeout server          {{ haproxy_timeout_server }}
    timeout http-request    10s
    timeout http-keep-alive 5s
    timeout queue           30s
    timeout check           3s

frontend http_in
    bind *:{{ haproxy_frontend_port }}
    option forwardfor
    http-request set-header X-Forwarded-Proto http
    default_backend {{ haproxy_backend }}

backend {{ haproxy_backend }}
    balance {{ haproxy_balance }}
    option httpchk
    http-check send meth GET uri {{ haproxy_health_uri }} ver HTTP/1.1 hdr Host {{ haproxy_health_host }}
    http-check expect status 200
    default-server check inter {{ haproxy_check_inter }} fall {{ haproxy_check_fall }} rise {{ haproxy_check_rise }>
{% for h in groups['web'] %}
    server {{ hostvars[h].haproxy_server_name }} {{ hostvars[h].haproxy_backend_address | default(hostvars[h].ansib>
{% endfor %}
{% if haproxy_stats_password | length > 0 %}

listen stats
    bind {{ haproxy_stats_bind }}
    stats enable
    stats uri /
    stats refresh 2s
    stats show-legends
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}

