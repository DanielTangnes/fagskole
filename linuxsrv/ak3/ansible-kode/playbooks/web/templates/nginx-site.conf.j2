# {{ ansible_managed }}

server {
    listen      80 default_server;
    listen      [::]:80 default_server;

    server_name {{ server_name }};
    root        {{ web_root }};

    index   index.php index.html;
    charset utf-8;

    access_log /var/log/nginx/{{ site_name }}.access.log;
    error_log  /var/log/nginx/{{ site_name }}.error.log;

    client_max_body_size {{ php_upload_max_filesize }};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # HAProxy health check. Runs a tiny PHP script that lives outside the
    # repo, so it proves nginx -> PHP-FPM works regardless of what's deployed.
    location = /health {
        access_log     off;
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME {{ health_check_dir }}/health.php;
        fastcgi_pass   unix:{{ php_fpm_socket }};
    }

    # Front controller: anything that is not a real file goes to index.php
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    # fastcgi-php.conf already does the "does the script exist" try_files
    location ~ \.php$ {
        include        snippets/fastcgi-php.conf;
        fastcgi_pass   unix:{{ php_fpm_socket }};
        fastcgi_param  HTTP_PROXY "";
        fastcgi_read_timeout {{ php_max_execution_time }}s;
    }

    location ~* \.(css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|woff2?|ttf)$ {
        expires    30d;
        access_log off;
        try_files  $uri =404;
    }

    # Block dotfiles (.git, .env, .htaccess) but keep ACME challenges working
    location ~ /\.(?!well-known) {
        deny all;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }
}

